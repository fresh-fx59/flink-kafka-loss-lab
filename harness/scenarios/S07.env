DESCRIPTION="committed offsets EXPIRE while the group is empty: broker offsets.retention.minutes=1 and an outage held open for 3 minutes. Does expiry cause a replay (safe) or a skip (loss)?"
STARTING_OFFSETS=committed-earliest
ENABLE_AUTO_COMMIT=true
AUTO_COMMIT_INTERVAL_MS=5000
CHECKPOINTING_MS=0
OFFSETS_RETENTION_MINUTES=1
OUTAGE_SLEEP_SECONDS=200
EXPECT=no-loss
