DESCRIPTION="the suspected production bug: the source reads the whole backlog and the sink SWALLOWS the failure - offsets advance, rows never land, nothing turns red"
STARTING_OFFSETS=committed-earliest
ENABLE_AUTO_COMMIT=true
AUTO_COMMIT_INTERVAL_MS=5000
CHECKPOINTING_MS=0
SINK_FAILURE_MODE=swallow
SINK_FAIL_SECONDS=45
EXPECT=loss
