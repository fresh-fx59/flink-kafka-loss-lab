DESCRIPTION="idempotency fix: unique index on event_id + ON CONFLICT DO NOTHING -> replay converges to the exact row set, no merge schedule to wait for"
STARTING_OFFSETS=earliest
ENABLE_AUTO_COMMIT=false
CHECKPOINTING_MS=0
SINK_MODE=on-conflict-ignore
PK_ON_EVENT_ID=true
UNIQUE_REQUIRED=true
EXPECT=no-loss
