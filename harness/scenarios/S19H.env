DESCRIPTION="S19 done honestly: DeliveryGuarantee.NONE, no checkpoints, auto-commit advancing on a 1s timer, and the TaskManager SIGKILLed. A graceful cancel flushes the producer and hides the defect; a crash does not."
KILL_JOB=router
KILL_MODE=hard
KAFKA_SINK_GUARANTEE=NONE
ROUTER_CHECKPOINTING_MS=0
SINK_CHECKPOINTING_MS=0
ENABLE_AUTO_COMMIT=true
AUTO_COMMIT_INTERVAL_MS=1000
SINK_MODE=plain-insert
PK_ON_EVENT_ID=false
RATE=200
EXPECT=loss
