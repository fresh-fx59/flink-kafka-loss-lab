DESCRIPTION="S21 with NO deduplication: how many duplicates does the timestamp strategy actually produce on its own? S21 reported zero only because a unique index was absorbing them."
STARTING_OFFSETS=committed-earliest
RESTART_STARTING_OFFSETS=timestamp:OUTAGE_START
ENABLE_AUTO_COMMIT=true
CHECKPOINTING_MS=0
TS_TYPE=LogAppendTime
SINK_MODE=plain-insert
PK_ON_EVENT_ID=false
EXPECT=no-loss
